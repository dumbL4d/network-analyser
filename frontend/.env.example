# Vite reads VITE_* vars into import.meta.env at BUILD time. Because this is a
# static SPA, the value is baked into the JS bundle -- there is no runtime
# env in the deployed nginx image (the Docker build accepts it as --build-arg
# VITE_API_BASE_URL).
#
# Set this to wherever the backend is actually reachable FROM THE BROWSER in a
# given deployment. This is a browser-side concern: API calls originate from
# the user's browser, not from the frontend container, so in production this
# should be the backend's public host/port -- not necessarily "localhost".
#
# This default is only correct for local development (npm run dev + backend on
# localhost:8000).
VITE_API_BASE_URL=http://localhost:8000