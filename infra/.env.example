# Copy this file to `infra/.env` and fill in the values before starting the
# stack. Docker Compose reads `infra/.env` automatically when you run
# `docker compose -f infra/docker-compose.yml ...` from the repo root.
#
# infra/.env is git-ignored (.env matches at any level) -- never commit real
# secrets.

# REQUIRED -- JWT signing secret. Compose refuses to start without it (the
# `:?` interpolation fails fast on a missing value), and the backend refuses
# to start while it is still the placeholder below or shorter than 32
# characters: whoever knows the secret can sign in as any user. Generate a
# real random value:
#
#     openssl rand -hex 32
#
JWT_SECRET_KEY=generate_me_with_openssl_rand_hex_32

# OPTIONAL -- the first passwords of the two default accounts, "admin" and
# "viewer". They are only used when the database is created. Leave one empty
# and the backend generates a random password and writes it to its log, once:
#
#     docker compose -f infra/docker-compose.yml logs backend | grep "initial password"
#
# Either way each account has to change its password at the first login, and
# until then it can do nothing else.
ADMIN_INITIAL_PASSWORD=
VIEWER_INITIAL_PASSWORD=

# !!! INSECURE -- FOR DEMOS ONLY !!!  Leave it "false" anywhere that matters.
# "true" creates the default accounts with the passwords printed in the README
# (admin / admin123 and viewer / viewer123) and switches the forced password
# change off. It only chooses the passwords of a NEW database: to switch an
# existing one to the demo credentials, recreate it (`down -v`, then `up`).
# It also lets the backend start on the placeholder JWT_SECRET_KEY above.
DEMO_MODE=false

# OPTIONAL -- how long a login lasts, in minutes. After that the user signs in
# again (there are no refresh tokens).
JWT_EXPIRE_MINUTES=60

# CORS origins the backend allows, JSON-array form (pydantic-settings parses
# the list[str] CORS_ORIGINS field as JSON). The default permits both the Vite
# dev-server origin (:5173) and the containerized nginx frontend (:8080). Add
# any other frontend origins a given deployment needs. Each entry is an exact
# origin, scheme://host[:port]: no "*", no path and no trailing slash, or the
# backend refuses to start.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# The address the end user's BROWSER will use to reach the backend API. This is
# baked into the frontend bundle at image BUILD time (VITE_API_BASE_URL), so
# changing it requires `up -d --build`. The default is correct for local
# testing (backend published on localhost:8000); point it at the server's
# LAN-reachable host/port for a real warehouse deployment.
FRONTEND_API_BASE_URL=http://localhost:8000

# OPTIONAL -- how long one ping waits for its reply, in seconds. Each cycle a
# device gets several pings (4 by default, set in Admin > Settings), and one
# that does not answer costs this timeout once per ping: 8.6 s per cycle with
# the defaults. Lower it (to 1, say) on a fast local network for quicker
# cycles while something is down.
PING_TIMEOUT_SECONDS=2.0

# OPTIONAL -- data retention. Latency history and status transitions are kept
# in the backend-data volume; these control how long. The values below are the
# defaults, so the lines can be left out.
#   RAW_RETENTION_HOURS        raw samples older than this become 1-minute rollups
#   ROLLUP_RETENTION_DAYS      rollups older than this are deleted
#   TRANSITION_RETENTION_DAYS  status transitions older than this are deleted
#                              (also the period flaps are counted over)
#   RETENTION_INTERVAL_SECONDS how often the retention job runs (3600 = hourly)
RAW_RETENTION_HOURS=24
ROLLUP_RETENTION_DAYS=30
TRANSITION_RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600

# OPTIONAL -- fault injection (docs/chaos.md). The shared secret between the
# backend and the chaos agent. Without it fault injection stays off: the agent
# refuses to start and the chaos endpoints answer 503. To use it, uncomment
# the line, set a random value, and start the stack with `--profile chaos`:
#
#     openssl rand -hex 32
#
# CHAOS_AGENT_TOKEN=
