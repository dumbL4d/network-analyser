APP_NAME=Network Analyser API
APP_ENV=development
# JSON-array form -- pydantic-settings parses the list[str] CORS_ORIGINS field
# as JSON. Default allows the Vite dev origin under both spellings (`localhost`
# and `127.0.0.1` are different origins to a browser). The docker-compose
# deployment overrides this via infra/.env (CORS_ORIGINS) to also allow the
# nginx :8411 origin. Each entry is an exact origin, scheme://host[:port]: no
# "*", no path, no trailing slash.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Relative to the backend/ working directory
DATABASE_PATH=./data/network_analyser.db
# The devices seed file. Left out, the backend uses infra/devices.seed.json
# of this repository. Devices and links in it are added at every start if
# they are missing.
# SEED_PATH=../infra/devices.seed.json

# Ping engine
# PING_PRIVILEGED=True uses raw ICMP sockets (Docker with cap_add: [NET_RAW], or root).
# Set PING_PRIVILEGED=False for local dev without root (unprivileged fallback mode).
PING_PRIVILEGED=True
# How long ONE ping waits for its reply. A device gets several pings per cycle
# (pings_per_cycle, in Admin > Settings). They do not wait for each other, so
# one that does not answer costs this timeout once per cycle, after the last.
PING_TIMEOUT_SECONDS=2.0
# Fallbacks only. The poll interval and the latency thresholds live in the
# database and are edited in Admin > Settings; these three are used only if
# that settings row is missing (the interval also until it has been read).
PING_INTERVAL_SECONDS=8.0
LATENCY_WARN_MS=100.0
LATENCY_CRIT_MS=500.0
# Set to False to start the API without the background poll loop (the test
# suite does this). Nothing is pinged, so every device stays "unknown".
POLL_ENABLED=True

# Rolling latency history: how many recent samples per device are kept in
# memory (the hot cache behind the default /api/history response). They are
# also stored in the database, so they survive a restart.
HISTORY_MAX_SAMPLES=36

# Data retention (see "Data persistence and retention" in docs/architecture.md)
# Raw samples older than this are folded into 1-minute rollups.
RAW_RETENTION_HOURS=24
# 1-minute rollups older than this are deleted.
ROLLUP_RETENTION_DAYS=30
# Status transitions older than this are deleted. Also the window over which
# flaps are counted.
TRANSITION_RETENTION_DAYS=30
# How often the retention job runs (3600 = hourly).
RETENTION_INTERVAL_SECONDS=3600

# JWT auth
# The value below is a placeholder, not a secret: whoever knows the secret can
# sign in as any user. The backend refuses to start on it, or on anything
# shorter than 32 characters, unless DEMO_MODE is True. Put your own here,
# for example the output of:
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_DEV_ONLY_INSECURE_DEFAULT
JWT_ALGORITHM=HS256
# How long a login lasts, in minutes.
JWT_EXPIRE_MINUTES=60

# The first passwords of the two default accounts ("admin" and "viewer"), used
# only when the database is created. Left empty, a random one is generated and
# written to the log, once. Either way it has to be changed at the first login.
ADMIN_INITIAL_PASSWORD=
VIEWER_INITIAL_PASSWORD=
# !!! INSECURE -- FOR DEMOS AND THROWAWAY LOCAL SETUPS ONLY !!!
# True creates the two accounts with the documented passwords (admin /
# admin123, viewer / viewer123) and switches the forced password change off.
# It also lets the backend start on the placeholder JWT_SECRET_KEY above.
DEMO_MODE=False

# Fault injection (docs/chaos.md). Both must be set for the chaos endpoints
# to do anything; otherwise they answer 503. The agent only runs in the
# Docker Compose stack (profile "chaos"), which sets both for the backend.
# CHAOS_AGENT_URL=http://chaos-agent:8081
# CHAOS_AGENT_TOKEN=
